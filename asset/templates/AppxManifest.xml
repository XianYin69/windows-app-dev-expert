<?xml version="1.0" encoding="utf-8"?>
<!-- AppxManifest.xml — MSIX 打包清单骨架（非打包应用无此文件，见 msix_probe） -->
<!-- 打包身份决定数据目录（Windows.Storage.ApplicationData）与后台任务通道。 -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="Contoso.SampleDesktop" Publisher="CN=Contoso"
            Version="1.0.0.0" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>Sample Desktop App</DisplayName>
    <PublisherDisplayName>Contoso</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <!-- Windows App SDK 框架包依赖：版本须与目标机已装版本比对 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0"/>
  </Dependencies>
  <Resources>
    <Resource Language="zh-CN"/>
    <Resource Language="en-US"/>
  </Resources>
  <Applications>
    <Application Id="SampleApp" Executable="SampleApp.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Sample Desktop App" Description="Skeleton"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"/>
      <Extensions>
        <!-- 协议启动示例：注册后须实测 OpenWith 结果，不得凭写清单即断言生效 -->
        <uap:Protocol Name="contoso-sample">
          <uap:DisplayName>Contoso Sample Protocol</uap:DisplayName>
        </uap:Protocol>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
